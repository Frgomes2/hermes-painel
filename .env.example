# =============================================================================
# Painel do Hermes. Copie para .env e preencha. O .env NAO vai para o git.
# =============================================================================

# MESMO banco do Hermes. Na sua maquina use a URL PUBLICA da Railway.
DATABASE_URL=postgresql://postgres:senha@viaduct.proxy.rlwy.net:PORTA/railway

# Senha do papel `hermes_app`, a MESMA do serviço do Hermes.
#
# O painel NAO SOBE sem ela, e isso é de propósito: a conexão de administração
# na Railway é superusuário, e superusuário IGNORA row level security. Um
# painel multiempresa sem RLS mostra os dados de uma barbearia para outra na
# primeira consulta.
APP_DB_PASSWORD=

# Onde está o Hermes. Só o agente passa por aqui (o simulador); cadastro e
# agenda o painel lê direto do banco.
#
# Dentro da Railway, endereço interno (não passa pela internet):
#   http://hermes.railway.internal:8080
# Da sua máquina, o domínio público:
#   https://hermes-production-ef4d.up.railway.app
HERMES_API_URL=

# Segredo da API interna. Precisa ser IDÊNTICO ao do serviço do Hermes —
# valores diferentes dão 401 em toda chamada do simulador.
# Gere uma vez: openssl rand -hex 32
INTERNAL_API_SECRET=
